{
  "name": "easel-client",
  "version": "0.0.5",
  "description": "Electron client for venetanji/easel",
  "main": "src/main.js",
  "workspaces": [
    "packages/media-mcp"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js && npm run test --workspace=@easel/media-mcp",
    "build:media-mcp": "npm run build --workspace=@easel/media-mcp",
    "build:canvas-kits": "node scripts/build-canvas-kits.js",
    "check:release-version": "node scripts/check-release-version.js",
    "build": "npm run check:release-version && npm run build:media-mcp && npm run build:canvas-kits && npm run build:video-runtime",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis zip",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:video-runtime": "node scripts/build-video-runtime.js",
    "test:video-export": "npm run build:video-runtime && node scripts/smoke-video-export.cjs",
    "test:video-live": "npm run build:media-mcp && npm run build:video-runtime && node scripts/test-live-video-workflow.cjs"
  },
  "overrides": {
    "hono": "4.13.9"
  },
  "dependencies": {
    "@easel/media-mcp": "0.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "acorn": "^8.18.0",
    "markdown-it": "^15.0.2",
    "mediabunny": "1.61.0",
    "openai": "7.15.0",
    "parse5": "8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venetanji/easel-client.git"
  },
  "keywords": [
    "electron",
    "easel"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@strudel/web": "1.3.0",
    "electron": "^44.4.5",
    "electron-builder": "26.16.1",
    "esbuild": "^0.28.2",
    "matter-js": "^0.20.0",
    "p5": "2.3.4",
    "phaser": "^4.2.1",
    "three": "^0.186.1",
    "tone": "^15.1.22"
  }
}
